<?xml version="1.0" encoding='utf-8'?>
<odoo>

    <record id="expense_form_converison_customization_form" model='ir.ui.view'>
        <field name='name'>expense.form.customization</field>
        <field name="model">expense.module</field>
        <field name="inherit_id" ref="Record_Expense.view_expense_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_posted']" position='after'>
                <field name="conversion_rate"/>
                <field name="currency__convert_id"/>
                <!-- <field name="readonly_check"/> -->
            </xpath>

            <xpath expr="//field[@name='expense_line'][1]//tree[1]/field[@name='value']" position="replace">
                <field name="value" widget="monetary" options="{'currency_field': 'convert_currency_id', 'field_digits': True}"/>
                <field name="convert_currency_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>