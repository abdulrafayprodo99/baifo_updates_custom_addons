                        <button name="open_cancel_wizard"
                            attrs="{'invisible': [('approval_state', 'in', 'cancel')]}"
                            string="Cancel" type="object" class="oe_highlight" />

                        <button name="704"
                            attrs="{'invisible': [('approval_state', '!=', 'approve')]}"
                            string="Create RFQ" type="action" />
                        <field name="approval_state" widget="statusbar"
                            statusbar_visible="store_supervisors,verify,approve,cancel" />
                    </header>

