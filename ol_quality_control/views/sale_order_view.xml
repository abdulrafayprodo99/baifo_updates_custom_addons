<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="payment_term_id_readonly" model="ir.ui.view">
            <field name="name">payment.term.id.readonly</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">

                <field name="payment_term_id" position="attributes">
                    {'required': "1"}
                </field>
            </field>
        </record>
        <record id="payment_term_id_readonly_po" model="ir.ui.view">
            <field name="name">payment.term.id.readonly.po</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form" />
            <field name="arch" type="xml">
           
                <field name="payment_term_id" position="attributes">
                    {'required': "1"}
                </field>
            </field>
        </record>
        <record id="invoice_payment_term_id_readonly" model="ir.ui.view">
            <field name="name">invoice.payment.term.id.readonly</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
           
                <field name="payment_reference" position="after">
                   <field name="asset" widget="many2many_tags"/>
                </field>
            </field>
        </record>
    </data>
</odoo>