<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//form[1]/sheet[1]/notebook[1]/page[@name='products']/field[@name='order_line']/tree[1]/field[@name='product_uom']"
                position="replace">
                <field name='product_uom' attrs="{'readonly':'1'}" />
            </xpath>

        </field>
    </record>

    <record id="purchase_request_form_inherit" model="ir.ui.view">
        <field name="name">purchase.request.form.inherit.readonly.product_uom_id</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form" />
        <field name="arch" type="xml">
            <!-- XPath to locate the second product_uom_id field and make it readonly -->
            <xpath expr="//field[@name='product_uom_id'][@groups='uom.group_uom']"
                position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="custom_invoice_view_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.readonly.uom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- XPath to locate the product_uom_id field in invoice lines and make it readonly -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']"
                position="replace">
                <field name="product_uom_backup"/>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_inherit" model="ir.ui.view">
        <field name="name">mrp.production.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <!-- XPath to locate the product_uom_id field in invoice lines and make it readonly -->
            <xpath expr="//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="attrs">
                    {
                        'readonly':True
                    }
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_unbuild_inherit" model="ir.ui.view">
        <field name="name">mrp.production.unbuild.inherit</field>
        <field name="model">mrp.unbuild</field>
        <field name="inherit_id" ref="mrp.mrp_unbuild_form_view" />
        <field name="arch" type="xml">
            <!-- XPath to locate the product_uom_id field in invoice lines and make it readonly -->
            <xpath expr="//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="attrs">
                    {
                        'readonly':True
                    }
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="stock_scrap_inherit" model="ir.ui.view">
        <field name="name">stock.scrap.inherit</field>
        <field name="model">stock.scrap</field>
        <field name="inherit_id" ref="stock.stock_scrap_form_view" />
        <field name="arch" type="xml">
            <!-- XPath to locate the product_uom_id field in invoice lines and make it readonly -->
            <xpath expr="//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="readonly">
                    1
                </attribute>
            </xpath>
        </field>
    </record>
    <record id="view_rfq_comparison_model_form_inherit" model="ir.ui.view">
        <field name="name">view.rfq.comparison.model.form.inherit</field>
        <field name="model">rfq.comparison</field>
        <field name="inherit_id" ref="prodo_x_biafo_ext.view_rfq_comparison_model_form" />
        <field name="arch" type="xml">
            <!-- Make product_uom_id readonly in PR Details -->
            <xpath expr="//page[@name='pr_details']//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Make product_uom_id readonly in RFQ Details -->
            <xpath expr="//page[@name='rfq_details']//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Make product_uom_id readonly in Vendor Selection -->
            <xpath expr="//page[@name='vendor_selection']//field[@name='product_uom_id']"
                position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>


</odoo>