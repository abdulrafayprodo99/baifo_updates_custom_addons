<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Asir working for RFQ sequence -->
        <!-- Sequences for RFQ -->
        <record id="seq_rfq_state_po" model="ir.sequence">
            <field name="name">RFQ Sequence PO</field>
            <field name="code">rfq.po.state</field>
            <field name="prefix">RFQ-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for RFQ Comparison Record -->
        <record id="seq_rfq_comparison_record" model="ir.sequence">
            <field name="name">RFQ Comparison Sequence</field>
            <field name="code">rfq.comparison.sequence</field>
            <field name="prefix">CS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="create_rfq_comparison_from_rfqs" model="ir.actions.server">
            <field name="name">Create RFQs Comparison</field>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="binding_model_id" ref="purchase.model_purchase_order"/>
            <field name="code">
               records.create_rfq_comparisons()
            </field>
        </record>

        <!-- RQI Sequence -->
        <record id="seq_riq_record" model="ir.sequence">
            <field name="name">QIR  Sequence</field>
            <field name="code">qir.sequence</field>
            <field name="prefix">QIR-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_pj" model="ir.sequence">
        <field name="name">PJ Sequence</field>
        <field name="code">pj</field>
        <field name="prefix">PJ-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
        </record>


        <record id="seq_cm_state_po" model="ir.sequence">
            <field name="name">Contract Management</field>
            <field name="code">cms</field>
            <field name="prefix">COS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <record id="seq_cm_state_vpa" model="ir.sequence">
            <field name="name">Contract Management</field>
            <field name="code">cmo</field>
            <field name="prefix">COP-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for Sale Quotation Local-->
        <record id="seq_rfq_state_so" model="ir.sequence">
            <field name="name">RFQ Sale Quotation Seq L</field>
            <field name="code">rfq.so.state.L</field>
            <field name="prefix">SQL-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Noman -->
        <record id="seq_doe_state" model="ir.sequence">
            <field name="name">Delivery Challan Export Seq </field>
            <field name="code">doe.state</field>
            <field name="prefix">DOE-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for Sale Quotation Local-->
        <record id="seq_rfq_state_so" model="ir.sequence">
            <field name="name">RFQ Sale Quotation Seq E</field>
            <field name="code">rfq.so.state.E</field>
            <field name="prefix">SQE-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequences for Sale Quotation Local-->
        <record id="seq_rfq_state_sqs" model="ir.sequence">
            <field name="name">RFQ Sale Quotation Seq S</field>
            <field name="code">rfq.so.state.S</field>
            <field name="prefix">SQS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_so_state_sos" model="ir.sequence">
            <field name="name">RFQ Sale Quotation Seq S</field>
            <field name="code">so.state.S</field>
            <field name="prefix">SOS-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        

        <record id="sequence_subtype" model="ir.sequence">
            <field name="name">Operation Subtype</field>
            <field name="code">seq_bom_x</field>
            <field name="prefix">%(day)s%(month)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
       </record>

        <!-- asset location sequence -->

    </data>
</odoo>