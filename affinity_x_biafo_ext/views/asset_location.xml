<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- For Tree View -->
    <record id="view_asset_location_tree" model="ir.ui.view">
        <field name="name">view.asset.location.tree</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="id__"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="asset_location_model_view_form" model="ir.ui.view">
        <field name="name">asset.location.view.form</field>
        <field name="model">asset.location</field>
        <field name="arch" type="xml">
            <form string="Type Form">
                <sheet>

                <group>
                    <field name="name" />
                    <field name="id__" />
                </group>
                    <!-- <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="id__" />
                        </h1>
                    </div> -->

                </sheet>
            </form>
        </field>
    </record>


	<record id="asset_location_model_action" model="ir.actions.act_window">
	    <field name="name">Asset Location</field>
	    <field name="type">ir.actions.act_window</field>
	    <field name="res_model">asset.location</field>
	    <field name="view_mode">tree,form</field>
	    <field name="help" type="html">
	        <p class="o_view_nocontent_smiling_face">
	             Create Your First Record
	        </p>
        </field>
    </record>

    <menuitem id="asset_location_model_root" name="Asset Location" parent="account.menu_finance_entries_management" action="asset_location_model_action" />

 </odoo>