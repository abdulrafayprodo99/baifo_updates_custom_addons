<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_move_purchase_landed_cost" model="ir.ui.view">
            <field name="name">stock.move.landed_cost.form</field>
            <field name="model">stock.move</field>
            <field name="inherit_id" ref="stock.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='origin_grp']" position="inside">
                     <field name="analytic_distribution_landed_cost" widget="analytic_distribution" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
