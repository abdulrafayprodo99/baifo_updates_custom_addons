<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_move_form_inherited_do_ref" model="ir.ui.view">
        <field name="name">account.move.form.inherit.do.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="do_ref" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
            </xpath>
        </field>
    </record>


    <record id="view_out_invoice_tree_inherited_do_ref" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.do.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="do_ref"/>
            </xpath>
        </field>
    </record>
    </data>
</odoo>