<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_form_inherited_for_set_to_null" model="ir.ui.view">
        <field name="name">view_picking_form_inherited</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header[1]" position="inside">
                <button name="set_to_null" string="Set To Draft" type="object" class="btn-primary" attrs="{'invisible': 1}" data-hotkey="w"/>
            </xpath>
        </field>
    </record>
</odoo>
