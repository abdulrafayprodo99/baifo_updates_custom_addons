<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_view_mrp_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.form.modifications</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='components']/field[@name='bom_line_ids']/tree[1]/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
              </xpath>
        </field>
    </record>

</odoo>