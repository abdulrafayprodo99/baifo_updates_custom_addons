<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_view_po_form" model="ir.ui.view">
        <field name="name">purchase.order.form.modifications</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_qty']" position="attributes">
                <!--<attribute name="readonly">parent.purchase_request_id != False</attribute>-->
                <attribute name="attrs">{'readonly' : [('parent.purchase_request_id', '!=', False)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
