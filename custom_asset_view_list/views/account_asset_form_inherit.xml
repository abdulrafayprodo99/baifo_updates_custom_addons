<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_asset_form_inherit" model="ir.ui.view">
        <field name="name">account.asset.form.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset_no_days_issue.view_account_asset_form_inherited"/>
        <field name="arch" type="xml">
            <!-- Example: Add a new field below the existing asset_type field -->
            <xpath expr="//field[@name='old_asset_original_value']" position="replace">
                <field name="old_asset_original_value" string="Opening Asset Value"/>
            </xpath>

            <xpath expr="//field[@name='sr_no']" position="replace">
                <field name="sr_no" string="Asset ID"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_asset_form_inherit_2" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.second</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <!-- Example: Add a new field below the existing asset_type field -->
            <xpath expr="//field[@name='original_value']" position="replace">
                <field name="original_value" string="Opening Depricated Value"/>
            </xpath>
        </field>
    </record>
    <record id="view_account_asset_tree_inherit" model="ir.ui.view">
        <field name="name">account.asset.tree.inherit</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_purchase_tree"/>
        <field name="arch" type="xml">
            <!-- Example: Add a new field below the existing asset_type field --> 
             

            <xpath expr="//field[@name='acquisition_date']" position="replace">
            </xpath> 
            
            <xpath expr="//field[@name='name']" position="before">
                <field name="sr_no"/>
                <field name="acc_class_id" optional="show" />
                <field name="sub_acc_class_id" optional="show" />
                <field name="model_id" />
                

            </xpath> 

            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_tag"/>
                <field name="acquisition_date" />
                <field name="old_asset_original_value" string="Opening Asset Value"/>
                    <field name="additions_disposals" optional="show"/>
    <field name="close_asset_value" optional="show"/>

                <field name="opening_accumulated_depreciation" />
                <field name="depreciation_for_the_period"/>
                <field name="depreciation_disposal"/>
                <field name="closing_accumulated_depreciation" />
                <field name="disposal" />
                <field name="wdv" />
            </xpath> 

            <xpath expr="//field[@name='original_value']" position="replace">
                <field name="original_value" optional="hide"/>
            </xpath> 

            <xpath expr="//field[@name='method']" position="replace">
                <field name="method" optional="hide"/>
            </xpath> 

            <xpath expr="//field[@name='book_value']" position="replace">
                <field name="book_value" optional="hide"/>
            </xpath> 

            <xpath expr="//field[@name='value_residual']" position="replace">
                <field name="value_residual" widget="monetary" optional="hide"/>
            </xpath> 

            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" optional="hide"/>
            </xpath>



        </field>
    </record>

</odoo>
