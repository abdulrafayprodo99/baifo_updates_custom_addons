                                    </td>
                                    <td style="text-align:center; padding:2px;">
                                        <span t-field="line.product_uom_id.name" />
                                    </td>
                                    <td style="text-align:center; padding:2px;">
                                        <span t-esc="line.quantity"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                    </td>
                                    <td style="text-align:right; padding:2px;">
                                        <span t-esc="line.price_unit"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                    </td>
                                    <td style="text-align:right; padding:2px;">
                                        <span t-esc="line.price_subtotal"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align:center;border-bottom:2px solid black">
                                        <!--<t
                                        t-set="s_no" t-value="s_no + 1"/>-->
                                        <!--<t
                                        t-esc="s_no"/>-->
                                    </td>
                                    <td
                                        style="text-align:left;border-bottom:2px solid black; padding:2px;">
                                        <!--<span
                                        t-field="line.product_id.default_code"/>-->
                                    </td>
                                    <td
                                        style="text-align:left;border-bottom:2px solid black; padding:2px;">
                                        <!--<span
                                        t-field="line.name"/>-->
                                    </td>
                                    <td
                                        style="text-align:left; padding:2px;border-bottom:2px solid black">
                                        <!--<span
                                        t-field="line.product_id.product_tmpl_id.product_specification"/>-->
                                    </td>
                                    <td
                                        style="text-align:center;border-bottom:2px solid black;padding:2px;">
                                        <!--<span
                                        t-field="line.product_uom_id.name"/>-->
                                    </td>
                                    <td
                                        style="text-align:right; padding:2px;border-bottom:2px solid black;" />
                                    <td
                                        style="text-align:right; padding:2px;border-bottom:2px solid black" />
                                </tr>
                            </table>
                        </div>
                        <div class="calculation mt-2" style="font-size:13px">
                            <div class="row">
                                <div class="col-8" />
                                <div class="col-4">
                                    <div class="row">
                                        <div class="col">
                                            <div class="row">
                                                <div class="col-7" style="text-align:right">
                                                    <b>
                                                        <span>Value (Excl Sale Tax):</span>
                                                    </b>
                                                </div>
                                                <br />
                                                <div class="col-5"
                                                    style="text-align:right;border-bottom:1px solid black; ">
                                                    <b>
                                                        <span t-esc="float(doc.amount_untaxed)"
                                                            t-options="{'widget': 'float', 'precision': 2}" />
                                                    </b>
                                                    <!--<span
                                                    t-field="doc.x_studio_gross_amount"/>-->
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-7" style="text-align:right">
                                                    <b>
                                                        <span>Sales Tax:</span>
                                                    </b>
                                                </div>
                                                <div class="col-5"
                                                    style="text-align:right; margin-top:3px;">
                                                    <b>
                                                        <t
                                                            t-foreach="doc.tax_totals['groups_by_subtotal']['Untaxed Amount']"
                                                            t-as="amount_by_group">
                                                            <t
                                                                t-esc="amount_by_group['tax_group_amount']"
                                                                t-options="{'widget': 'float', 'precision': 2}" />
                                                        </t>
                                                    </b>
                                                </div>
                                            </div>
                                            <t
                                                t-foreach="doc.tax_totals['groups_by_subtotal']['Untaxed Amount']"
                                                t-as="amount_by_group">
                                                <t
                                                    t-if="amount_by_group['tax_group_name'] == 'Re-Seller'">
                                                    <div class="row">
                                                        <div class="col-7">
                                                            <span>F. Tax</span>
                                                        </div>
                                                        <div class="col-5"
                                                            style="text-align:right; padding:1px;">
                                                            <b>
                                                                <t
                                                                    t-foreach="doc.tax_totals['groups_by_subtotal']['Untaxed Amount']"
                                                                    t-as="amount_by_group">
                                                                    <t
                                                                        t-if="amount_by_group['tax_group_name'] == 'Re-Seller'">
                                                                        <t
                                                                            t-esc="amount_by_group['tax_group_amount']" />
                                                                    </t>
                                                                </t>
                                                            </b>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>
                                            <div class="row">
                                                <div class="col-7" style="text-align:right">
                                                    <b>
                                                        <span>Value (Incl Sale Tax):</span>
                                                    </b>
                                                </div>
                                                <div class="col-5"
                                                    style="text-align:right;border-top:1px solid black; border-bottom:1px solid black; ">
                                                    <!--<span
                                                    t-field="doc.amount_total"/>-->
                                                    <b>
                                                        <span t-esc="float(doc.amount_total)"
                                                            t-options="{'widget': 'float', 'precision': 2}" />
                                                    </b>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="amountinwords">
                            <div class="row" style="font-size:13px">
                                <b>
                                    <span t-field="doc.number_to_words" />
                                    <span> Only</span>
                                </b>
                            </div>
                        </div>
                        <br />
                        <br />
                        <br />
                        <div class="qwerty" style="font-size:13px;">
                            <table style="border-collapse:collapse" class="table-borderless">
                                <t t-set="s_no" t-value="0" />
                                <t t-set="total_debit" t-value="0" />
                                <t t-set="total_credit" t-value="0" />
                                <thead>
                                    <th
                                        style="text-align:center;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:80px">
                                        <b>S No.</b>
                                    </th>
                                    <th
                                        style="text-align:left;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:240px">
                                        <b>Code / Account</b>
                                    </th>
                                    <th
                                        style="text-align:left;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:240px">
                                        <b>Partner / Analytic</b>
                                    </th>
                                    <th
                                        style="text-align:left;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:200px">
                                        <b>Narration</b>
                                    </th>
                                    <th
                                        style="text-align:right;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:130px">
                                        <b>Debit</b>
                                    </th>
                                    <th
                                        style="text-align:right;border-top:1px solid black;border-bottom:1px solid black;padding:4px;width:130px">
                                        <b>Credit</b>
                                    </th>
                                </thead>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td style="text-align:center">
                                        <t t-set="s_no" t-value="s_no + 1" />
                                        <t t-esc="s_no" />
                                    </td>
                                    <td style="text-align:left; padding:2px;">
                                        <span t-if="len(line.account_id.name_get()) &gt; 0"
                                            t-esc="line.account_id.name_get()[0][1]" />
                                    </td>
                                    <td style="text-align:left; padding:2px 4px;">
                                        <t t-set="analytic_values"
                                            t-value="doc._compute_analytic_distribution_name(line.analytic_distribution)" />
                                        <!--<span
                                        t-esc="str(doc.partner_id.name)"/>  <span
                                        t-field="line.analytic_distribution"/>-->
                                        <span t-esc="str(doc.partner_id.name)" />
                                        <t t-if="analytic_values" t-esc="'-'" />
                                        <t t-foreach="analytic_values" t-as="value">
                                            <span t-esc="value" />,&amp;nbsp; </t>
                                    </td>
                                    <td style="text-align:left; padding:2px;">
                                        <t t-if="line.name">
                                            <span t-field="line.name" />
                                        </t>
                                        <t t-else="">
                                            <t t-if="doc.ref"><span t-field="doc.ref" /> - </t>
                                            <t t-if="doc.invoice_date">
                                                <span t-set="date"
                                                    t-value="str(doc.invoice_date.day) + '-' +str(doc.invoice_date.strftime('%B')) + '-' + str(doc.invoice_date.year) " />
                                                <span t-esc="date" />
                                            </t>

                                        </t>
                                    </td>
                                    <td style="text-align:right; padding:2px;">
                                        <span t-esc="float(line.debit)"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                        <t t-set="total_debit"
                                            t-value="total_debit + float(line.debit)" />
                                    </td>
                                    <td style="text-align:right; padding:2px;">
                                        <span t-esc="float(line.credit)"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                        <t t-set="total_credit"
                                            t-value="total_credit + float(line.credit)" />
                                    </td>

                                </tr>
                                <tr>
                                    <td style="text-align:center">
                                        <t t-esc="''" />
                                    </td>
                                    <td style="text-align:left; padding:2px;">
                                        <span t-esc="''" />
                                    </td>
                                    <td style="text-align:left; padding:2px;">
                                        <span t-esc="''" />
                                    </td>
                                    <td style="text-align:left; padding:2px;">
                                        <span t-esc="''" />
                                    </td>
                                    <td
                                        style="text-align:right; padding:2px;border-top:1px solid black;border-bottom:1px solid black;">
                                        <span style="font-size:16px;font-weight:bolder;"
                                            t-esc="float(total_debit)"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                    </td>
                                    <td
                                        style="text-align:right; padding:2px;border-top:1px solid black;border-bottom:1px solid black;">
                                        <span style="font-size:16px;font-weight:bolder;"
                                            t-esc="float(total_credit)"
                                            t-options="{'widget': 'float', 'precision': 2}" />
                                    </td>

                                </tr>

                            </table>
                        </div>
