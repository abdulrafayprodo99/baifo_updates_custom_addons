    <record id="action_delivery_return_note" model="ir.actions.report">
        <field name="name">Delivery Return</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">po_return_sequence.delivery_return</field>
        <field name="report_file">po_return_sequence.delivery_return</field>
        <field name="print_report_name">'Delivery Return - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>
