<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherited" model="ir.ui.view">
        <field name="name">stock.picking.form.inherited</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="after">
                <field name="show_custom_fields" attrs="{'invisible' : 1}"/>
                <field name="name" attrs="{'invisible': [('show_custom_fields', '=', False)]}"/>
                <field name="designation" attrs="{'invisible' : 1}" />
                <field name="cnic_no" attrs="{'invisible' : 1}" />
                <field name="date" attrs="{'invisible' : 1}" />
            </xpath>
        </field>
    </record>
</odoo>
