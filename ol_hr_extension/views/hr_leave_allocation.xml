<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_allocation_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.allocation.view.form.manager.inherit</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form_manager" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group>

                    <field name="months_remaining" readonly="1"/>
                    <field name="leaves_remaining" readonly="1"/>
                    <field name="current_accural_rate" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
