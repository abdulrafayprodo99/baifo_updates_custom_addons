<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cancel_wizard_form" model="ir.ui.view">
        <field name="name">cancel.wizard.form</field>
        <field name="model">cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Rejection Note">
                <group>
                    <group>
                        <field name="rejection_note"/>
                    </group>
                </group>
                <footer>
                    <button name="action_cancel" type="object" string="Confirm" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Note</field>
        <field name="res_model">cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>