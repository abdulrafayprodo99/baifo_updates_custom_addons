<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_intimation_tree" model="ir.ui.view">
        <field name="name">intimation.tree</field>
        <field name="model">intimation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="customer_code" />
                <field name="partner_id" />
                <field name="delivery_address" />
                <field name="cc" optional="hide" />
                
            </tree>
        </field>
    </record>

    <record id="view_intimation_form" model="ir.ui.view">
        <field name="name">intimation.form</field>
        <field name="model">intimation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="customer_code"/>
                            <field name="delivery_address"/>
                            <field name="cc"/>
                            
                            
                            
                        </group>
                        
                    </group>
                        
                </sheet>
            </form>
        </field>
    </record>

    <record id="intimation_action" model="ir.actions.act_window">
            <field name="name">Intimation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">intimation</field>
            <field name="view_mode">tree,form</field>
        </record>

    <!-- <menuitem id="iso_root" name="ISO" parent="" sequence="10" /> -->
    <menuitem id="intimation" name="Intimation" parent="stock.menu_stock_config_settings" action="intimation_action" sequence="2"/>
</odoo>