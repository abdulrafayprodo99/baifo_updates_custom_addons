<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

<record id="email_template_request_prepared" model="mail.template">
    <field name="name">PR Template Report</field>
    <field name="model_id" ref="purchase_request.model_purchase_request"/>
    <field name="subject">{{object.name}} - Status Report - {{object.state}}</field>
    <field name="email_from">{{ (user.email_formatted or object.user_id.email_formatted) }}</field>
    <field name="email_to">waleed.sheikh@affinitysuite.net</field>
    <field name="partner_to"/>
    <field name="reply_to"/>
    <field name="body_html" type="html">
        <table border="0" cellpadding="0" cellspacing="0" style="padding-top: 16px; background-color: #F1F1F1; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; border-collapse: separate;">
            <tr>
                <td align="center">
                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="padding: 16px; background-color: white; color: #454748; border-collapse: separate;">
                        <tbody>
                            <!-- HEADER -->
                            <tr>
                                <td align="center" style="min-width: 590px;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse: separate;">
                                        <tr>
                                            <td valign="middle">
                                                <span style="font-size: 20px; font-weight: bold;" t-out="object.name"></span>
                                                <br/>
                                                Purchase Request #:
                                                <span style="font-size: 10px;" t-out="object.name"></span>
                                                <!-- Uncomment and adjust as needed -->
                                                <!-- Document Type #:
                                                <span style="font-size: 10px;" t-out="object.get_tci_type()"></span>
                                                <br/>
                                                Vendor Reference #:
                                                <span style="font-size: 10px;" t-out="object.reference"></span>
                                                <br/>
                                                Document Status:
                                                <span style="font-size: 10px;" t-out="object.state"></span>
                                                <br/> -->
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="text-align:center;">
                                                <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- CONTENT -->
                            <tr>
                                <td align="center" style="min-width: 590px;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse: separate;">
                                        <tr>
                                            <td valign="top" style="font-size: 13px;">
                                                <div>
                                                    Hi
                                                    <br/>
                                                    <span>The content of this communication is issued <strong>FOR INFORMATION ONLY</strong> and has no contractual value.</span>
                                                    <br/>
                                                    <br/>
                                                    <!-- Uncomment and adjust as needed -->
                                                    <!-- <t t-if="object.state == 'review'">
                                                        <span>The review process for <strong><span t-out="object.reference"></span></strong> has started. A notification will be sent to you when the review is completed.</span>
                                                        <br/>
                                                        <br/>
                                                        <span>The current email does not contain any attachment.</span>
                                                    </t>
                                                    <t t-if="object.state == 'rejected'">
                                                        <span>The review process for <strong><span t-out="object.reference"></span></strong> is completed and has been rejected.</span>
                                                        <br/>
                                                        <br/>
                                                        <span>The current email does not contain any attachment.</span>
                                                    </t>
                                                    <t t-if="object.state == 'approved'">
                                                        <span>The review process for <b><span t-out="object.reference"></span></b> is completed. It is now in queue to be included on the next batch.</span>
                                                        <br/>
                                                        <span>The current email does not contain any attachment.</span>
                                                        <br/>
                                                        <br/>
                                                    </t>
                                                    <t t-if="object.state == 'rejected'">
                                                        <span>Clarifications are required for <b><span t-out="object.reference"></span></b>. Please review the approver comments, update your document' content and re-submit using a revised document number.</span>
                                                        <br/>
                                                        <br/>
                                                    </t> -->
                                                    <!-- <div class="text-center">
                                                        <a t-att-href="object.get_lem_url()" class="btn btn-primary" t-att-target="'_blank'">View Document</a>
                                                    </div> -->
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="text-align:center;">
                                                <hr width="100%" style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- FOOTER -->
                            <tr>
                                <td align="center" style="min-width: 590px;">
                                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse: separate;">
                                        <tr>
                                            <td valign="middle" align="left">
                                                <span t-out="object.company_id.name"></span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td valign="middle" align="left" style="opacity: 0.7;">
                                                <span t-out="object.company_id.phone"></span>
                                                <t t-if="object.company_id.email">
                                                    |
                                                    <a href="mailto:{{object.company_id.email}}" style="text-decoration:none; color: #454748;">
                                                        <span t-out="object.company_id.email"></span>
                                                    </a>
                                                </t>
                                                <t t-if="object.company_id.website">
                                                    |
                                                    <a href="{{object.company_id.website}}" style="text-decoration:none; color: #454748;">
                                                        <span t-out="object.company_id.website"></span>
                                                    </a>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
            <!-- POWERED BY -->
            <tr>
                <td align="center" style="min-width: 590px;">
                    <table border="0" cellpadding="0" cellspacing="0" width="590" style="min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse: separate;">
                        <tr>
                            <td style="text-align: center; font-size: 13px;">
                                Project Solutions by
                                <!-- <a target="_blank" href="https://www.evosoft.ca?utm_source=db&amp;utm_medium=auth" style="color: #446c82;">Evosoft</a> -->
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </field>
    <field name="auto_delete" eval="True"/>
</record>


    </data>
</odoo>

