<!-- views/payment_wht_receipt_tree.xml -->
<odoo>
    <!-- Tree View for Tax Payment Receipt -->
    <record id="view_payment_wht_receipt_tree" model="ir.ui.view">
        <field name="name">payment.wht.line.tax.receipt.tree</field>
        <field name="model">payment.wht.line</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="payment_id" widget="many2one"/>
                <field name="vendor" widget="many2one"/>
                <field name="cheque_no" string="Cheque No" readonly="1"/>
                <field name="due_date" string="Due Date" readonly="1"/>
                <field name="challan_no"/>
                <field name="amount_wht"/>
                <field name="total_amount" string="Total Amount" readonly="1"/>
                <field name="bank_name"/>
                <field name="branch"/>
                <field name="cheque_to_be_issued"/>
                <field name="tax_date"/>
                <field name="cprm_no"/>
            </tree>
        </field>
    </record>

    <!-- Action to Show the Tree View -->
    <record id="action_tax_payment_receipt_lines" model="ir.actions.act_window">
        <field name="name">Tax Payment Receipts</field>
        <field name="res_model">payment.wht.line</field>
        <field name="view_mode">tree,kanban</field>
        <field name="view_id" ref="view_payment_wht_receipt_tree"/>
        <field name="domain">[('payment_id', '!=', False), ('payment_id.payment_type', '=', 'outbound')]</field>
    </record>


    <!-- Server Action to Launch Wizard
    <record id="action_tax_wht_submit" model="ir.actions.server">
        <field name="name">Tax Detail Updated</field>
        <field name="model_id" ref="model_payment_wht_line"/>
        <field name="binding_model_id" ref="model_payment_wht_line"/>
        <field name="binding_view_types">tree</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_window',
                'res_model': 'wht.receipt.wizard',
                'view_mode': 'form',
                'target': 'new',
                'context': {'active_ids': env.context.get('active_ids', [])},
            }
        </field>
    </record> -->

    <!-- Menu Item -->
    <menuitem id="menu_tax_payment_receipt"
              name="Tax Payment Receipt"
              parent="account.menu_finance_reports"
              action="action_tax_payment_receipt_lines"
              sequence="30"/>
</odoo>
