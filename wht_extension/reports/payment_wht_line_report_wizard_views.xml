<odoo>
    <!-- Action to open the wizard -->
    <record id="action_payment_wht_line_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Payment Report</field>
        <field name="res_model">payment.wht.line.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Form view for the report wizard -->
    <record id="view_payment_wht_line_report_wizard_form" model="ir.ui.view">
        <field name="name">payment.wht.line.report.wizard.form</field>
        <field name="model">payment.wht.line.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payment Report">
                <group>
                    <field name="serial_no" attrs="{'invisible': [('duplicate', '=', True)]}"/>
                    <field name="saved_report_id" attrs="{'invisible': [('duplicate', '=', False)]}"/>
                    <field name="duplicate"/>
                    <field name="partner_id" attrs="{'invisible': [('duplicate', '=', True)]}"/>
                    <field name="issue_date" attrs="{'invisible': [('duplicate', '=', True)]}"/>
                    <field name="from_date" attrs="{'invisible': [('duplicate', '=', True)]}"/>
                    <field name="to_date" attrs="{'invisible': [('duplicate', '=', True)]}"/>
                </group>
                
                <footer>
                    <button string="Generate Report" type="object" name="action_generate_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    
    <!-- Menu Item for the wizard -->
    <menuitem id="menu_payment_wht_line_report_wizard"
              name="Payment WHT Line Report"
              parent="account.menu_finance_reports"
              action="action_payment_wht_line_report_wizard"/>

</odoo>