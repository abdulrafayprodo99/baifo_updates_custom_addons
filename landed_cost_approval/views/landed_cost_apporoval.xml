<odoo>
    <record id="view_landed_cost_apporoval_from" model="ir.ui.view">
        <field name="name">landed_cost_apporoval.form</field>
        <field name="model">landed.cost.apporoval</field>
        <field name="arch" type="xml">
          <form>
          <sheet>
                <div class="oe_title">
                    <h1>
                        <field name="name" string="Name" />
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="po_no"/>
                        <field name="iqc_no"/>
                        <field name="landed_cost_approval"/>

                    </group>
                    <group>
                        <field name="grn_no"/>
                        <field name="landed_cost_attachd" widget="many2many_tags"/>
                        <field name="landed_cost_expense" widget="many2many_tags"/>
                    </group>

                </group>
                  
              </sheet>
          </form>
      </field>
      </record>
  
                              
                              
                              
      


    <record id="landed_cost_apporoval_action" model="ir.actions.act_window">
        <field name="name">Landed Cost Approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">landed.cost.apporoval</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Record
            </p>
        </field>
    </record>
    
    <menuitem id="landed_cost_apporoval_root" name="Landed Cost Approval" parent="" sequence="10" />
    <menuitem id="landed_cost_apporoval" name="Landed Cost Approval" action="landed_cost_apporoval_action" sequence="2" parent="landed_cost_apporoval_root" />
    
    <data>
        <record id="stock_picking_landend_cost_inherited_form_" model="ir.ui.view">
        <field name="name">stock.picking.landed.cost.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
                <field name="location_id" position="before">
                    <field name="import_grn_ref"/>
                </field>
            </field>
        </record>
        
    
    </data>
    

</odoo>