<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="import_attendance_form" model="ir.ui.view">
        <field name="name">import.attendance.view.form</field>
        <field name="model">import.attendance</field>
        <field name="arch" type="xml">
            <form string="Import Attendance">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="emp_id"/>
                        <field name="job_id"/>
                        <field name="month"/>
                        <field name="year"/>
                        <field name="total_days"/>
                        <field name="present_days"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="import_attendance_tree" model="ir.ui.view">
        <field name="name">import.attendance.tree</field>
        <field name="model">import.attendance</field>
        <field name="arch" type="xml">
            <tree string="Import Attendance">
                <field name="emp_id"/>
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="total_days"/>
                <field name="present_days"/>
            </tree>
        </field>
    </record>

    <record id="action_import_attendance" model="ir.actions.act_window">
        <field name="name">Import Attendance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="import_attendance_menu"
              name="Import Attendance"
              parent="hr_attendance.menu_hr_attendance_root"
              action="action_import_attendance"
              sequence="101"/>
</odoo>