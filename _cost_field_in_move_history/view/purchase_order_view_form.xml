<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_for_action_cancel_wizard" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']/group//group[@name='other_info']//field[@name='origin']" position="after">
                <field name="cancel_note" attrs="{'invisible':[('state','!=','cancel')]}" />
              </xpath>
        </field>
    </record>

</odoo>
