<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit_new</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[@name='late']" position="after">
                <filter string="Not Overdue" name="filter_not_overdue" domain="[('is_not_overdue', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="account_form_view_inherit" model="ir.ui.view">
        <field name="name">account.form.inherit_new</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="is_not_overdue"  invisible="1" />
            </xpath>
        </field>
    </record> 
</odoo>
