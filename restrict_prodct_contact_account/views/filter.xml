<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_search_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.stock.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='real_stock_negative']" position="after">
                <separator/>
                <filter string="To Approve" 
                name="to_approve" 
                domain="[('active', '=', False), ('approval_state', '=', 'prepared')]"
                />
            </xpath>

            <xpath expr="//filter[@name='real_stock_negative']" position="after">
                <separator/>
                <filter string="To Verify" 
                name="to_published" 
                domain="[('active', '=', False), ('is_published', '=', False)]"
                />
            </xpath>
        </field>
    </record>


    <record id="product_template_search_view_inherit_ribbin" model="ir.ui.view">
        <field name="name">product.template.search.stock.form.inherit.ribbon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_ok']" position="before">
                <span class="d-inline-block">
                    <field name="is_published"/>
                    <label for="is_published"/>
                </span>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="replace">
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': ['|', '|' ,('active', '=', True), '&amp;', ('active', '=', False), ('approval_state', '=', 'prepared'), '&amp;', ('active', '=', False), ('is_published', '=', False)]}"/>
            </xpath>
        </field>
    </record>





    <record id="res_partner_search_view_inherit" model="ir.ui.view">
        <field name="name">res.partner.search.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="To Approve" 
                name="to_approve" 
                domain="[('active', '=', False), ('approval_state', '=', 'verify')]"
                />
            </xpath>

            <xpath expr="//filter[@name='type_company']" position="after">
                <separator/>
                <filter string="To Verify" 
                name="to_published" 
                domain="[('active', '=', False), ('is_published', '=', False)]"
                />
            </xpath>
        </field>
    </record>



