    <record id="res_partner_kanban_view_inherit_ribbon" model="ir.ui.view">
        <field name="name">res.partner.kanban.form.inherit.ribbon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates/t/div/div" position="replace">
                <field name="approval_state" invisible="1"/>
                <field name="is_published" invisible="1"/>
                <div class="ribbon ribbon-top-right" attrs="{'invisible': ['|', '|' ,('active', '=', True), '&amp;', ('active', '=', False), ('approval_state', '=', 'prepared'), '&amp;', ('active', '=', False), ('is_published', '=', False)]}">
                    <span class="bg-danger">Archived</span>
                </div>
            </xpath>
        </field>
    </record>





    

    <record id="account_account_search_view_inherit" model="ir.ui.view">
        <field name="name">account.account.search.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='expensesacc']" position="after">
                <separator/>
                <filter string="To Approve" 
                name="to_approve" 
                domain="[('deprecated', '=', True), ('approval_state', '=', 'prepared')]"
                />
            </xpath>

            <xpath expr="//filter[@name='expensesacc']" position="after">
                <separator/>
                <filter string="To Verify" 
                name="to_published" 
                domain="[('deprecated', '=', True), ('is_published', '=', False)]"
                />
            </xpath>

        </field>
    </record>


    <record id="account_account_form_view_inherit" model="ir.ui.view">
        <field name="name">account.account.form.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <span class="d-inline-block">
                    <field name="is_published"/>
                    <label for="is_published"/>
                </span>
            </xpath>
        </field>
    </record>

