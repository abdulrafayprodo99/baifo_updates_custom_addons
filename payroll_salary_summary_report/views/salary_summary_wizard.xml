<odoo>
    <!-- Define an action to open the Salary Summary Report wizard -->
    <record id="action_hr_salary_summary_report" model="ir.actions.act_window">
        <field name="name">Payroll Summary Report</field>
        <field name="res_model">salary.summary.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Define the form view for the wizard -->
    <record id="salary_summary_report_form_view" model="ir.ui.view">
        <field name="name">salary.summary.report.form</field>
        <field name="model">salary.summary.report</field>
        <field name="arch" type="xml">
            <form string="Generate Salary Summary Report">
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                </group>
                <footer>
                    <button string="Generate PDF" type="object" name="action_generate_summary_report_pdf" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Link the action to the menu item -->
    <menuitem id="menu_hr_salary_summary_report"
              name="Payroll Summary Report (PDF)"
              parent="payroll_report_xlsx.menu_hr_salary_report_root"
              action="action_hr_salary_summary_report"
              sequence="40"/>
</odoo>