<!-- Inherit the base purchase request form view to add draft_number and approval_state -->
    <record id="view_purchase_request_form_draft_number" model="ir.ui.view">
        <field name="name">purchase.request.form.draft.number</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <!-- Add the approval_state field explicitly before it's used in attrs -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="approval_state" invisible="1"/>
            </xpath>
            <!-- Replace the name field with draft_number and name fields -->
            <xpath expr="//field[@name='name']" position="replace">
                <field name="draft_number" attrs="{'invisible': [('approval_state', '!=', 'initiated')]}" readonly="1"/>
                <field name="name" attrs="{'invisible': [('approval_state', '=', 'initiated')]}" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Define the sequence for draft_number -->
    <record id="seq_purchase_request_draft" model="ir.sequence">
        <field name="name">Purchase Request Draft</field>
        <field name="code">purchase.request.draft</field>
        <field name="prefix">Draft/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>

    
