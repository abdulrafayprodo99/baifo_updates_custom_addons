	<record id="paperformat_label_sheet_landscape" model="report.paperformat">
		<field name="name">Landscape Label Sheet</field>
		<field name="default" eval="True" />
		<field name="format">custom</field>
		<field name="page_height">297</field>
		<!-- A4 landscape height -->
		<field name="page_width">400</field>
		<!-- A4 landscape width -->
		<field name="orientation">Portrait</field>
		<field name="margin_top">12</field>
		<field name="margin_bottom">8</field>
		<field name="margin_left">5</field>
		<field name="margin_right">5</field>
		<field name="header_spacing">10</field>
		<field name="disable_shrinking" eval="False" />
		<field name="header_line" eval="False" />
		<field name="dpi">110</field>
	</record>
	<record id="custom_aged_receivable_report_action" model="ir.actions.report">
		<field name="name">Aged Receivable Report</field>
		<field name="model">account.move</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">aged_receviable_report.report_aged_receivable</field>
		<field name="report_file">aged_receviable_report.report_aged_receivable</field>
		<field name="paperformat_id" ref="paperformat_label_sheet_landscape" />
	</record>
