					</div>
					<!-- <hr style="width: 100%; background-color: black; height: 1px; border: none; margin-bottom:8px" /> -->
					<!-- Table Structure -->
					<table class="table table-condensed  py-5" style="margin: 20px;">
						<thead style="font-weight:950 !important;font-size:20px; font-family:sans-serif; border-top: 2px solid black; padding: 5px;border-bottom: 2px solid black; padding: 5px; margin-bottom: 15px !important; border-right-color: white; border-left-color: white; text-align: center; margin-top: 15px;">
							<!-- <hr style="width: 100%; background-color: black; height: 1px; border: none; margin-bottom:8px" /> -->
							<tr>
								<th rowspan="2" class="align-middle text-start fw-bold" style="border-bottom: 2px solid black;font-weight: bold !important; color: black;">
									<b>
										Narration
									</b>
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold" style="width: 400px; border-bottom: 2px solid black; color: black;">
									Partner Name
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold" style="width: 200px; border-bottom: 2px solid black; color: black;">
									Doc No.
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold" style="width: 150px; border-bottom: 2px solid black; color: black;">
									Date
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold" style="border-bottom: 2px solid black; color: black;">
									Credit Days
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold" style="border-bottom: 2px solid black; color: black;">
									Exact Days
								</th>
								<th rowspan="2" class="align-middle text-start fw-bold mr-5 pr-5" style="border-bottom: 2px solid black; color: black;">
									Overdue
								</th>
								<th colspan="1" class="text-end fw-bold" style="border-bottom: 2px solid black; color: black;">
									Net Due Amount
								</th>
								<th colspan="7" class="text-center fw-bold" style="border-bottom: 2px solid black; color: black;">
									Overdue Amounts
								</th>
								<th rowspan="2" class="align-middle fw-bold" style="border-bottom: 2px solid black; color: black;"/>
							</tr>
							<tr class="text-end">
								<th class="align-middle fw-bold" style="border-bottom: 2px solid black; color: black;"/>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									1 - 15 Days
								</th>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									16 - 30 Days
								</th>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									31 - 45 Days
								</th>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									46 - 60 Days
								</th>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									61 - 75 Days
								</th>
								<th class=" fw-bold" style="border-bottom: 2px solid black; color: black;">
									75+ Days
								</th>
								<th rowspan="2" class="align-middle fw-bold" style="border-bottom: 2px solid black; color: black;">
									Totals
								</th>
							</tr>
						</thead>
						<!-- Added margin-top to the tbody for space -->
						<tbody style="border-top-color: white; border-bottom-color: white; border-right-color: white; border-left-color: white; text-align: center; margin-top: 15px;">
							<!-- Data Population -->
							<t t-set="grand_total_net" t-value="0"/>
							<t t-set="grand_total_15" t-value="0"/>
							<t t-set="grand_total_31" t-value="0"/>
							<t t-set="grand_total_46" t-value="0"/>
							<t t-set="grand_total_61" t-value="0"/>
							<t t-set="grand_total_75" t-value="0"/>
							<t t-set="grand_total_75_plus" t-value="0"/>
							<t t-set="grand_total" t-value="0"/>
							<t t-set="current_partners" t-value="partners_ids"/>
							<t t-set="date" t-value="recorded_date"/>
							<!-- <t t-esc="current_partners"/> -->
							<t t-set="previous_narration_for_total" t-value="''"/>
							<t t-set="previous_narration" t-value="''"/>
							<t t-foreach="sorted(grouped_data.items(), key=lambda item: item[1]['invoices'][0]['narration'] if item[1]['invoices'] else '')" t-as="item">
								<t t-set="partner" t-value="item[1]"/>
								<t t-foreach="partner['invoices']" t-as="invoice">
									<t t-set="grand_total_net" t-value="grand_total_net + ((invoice['currency_rate']*invoice['amount_due']) if invoice['currency_name'] != 'PKR' else invoice['amount_due'] if invoice['over_due_days'] &lt; 1 else 0)"/>
									<t t-set="grand_total_15" t-value="grand_total_15 + ((invoice['currency_rate']*invoice['amount_due']) if invoice['currency_name'] != 'PKR' else invoice['amount_due'] if 0 &lt; invoice['over_due_days'] &lt; 16 else 0)"/>
									<t t-set="grand_total_31" t-value="grand_total_31 + ((invoice['currency_rate']*invoice['amount_due']) if invoice['currency_name'] != 'PKR' else invoice['amount_due'] if 15 &lt; invoice['over_due_days'] &lt; 31 else 0)"/>
									<t t-set="grand_total_46" t-value="grand_total_46 + ((invoice['currency_rate']*invoice['amount_due']) if invoice['currency_name'] != 'PKR' else invoice['amount_due'] if 30 &lt; invoice['over_due_days'] &lt; 46 else 0)"/>
