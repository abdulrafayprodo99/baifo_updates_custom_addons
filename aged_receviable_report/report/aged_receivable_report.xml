											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="15 &lt; invoice['over_due_days'] &lt; 31">
												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
												<!-- <t t-esc="'{:,}'.format(int(invoice['amount_due']))"/> -->
											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="30 &lt; invoice['over_due_days'] &lt; 46">
												<!-- <t t-esc="'{:,}'.format(int(invoice['amount_due']))"/> -->
												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="45 &lt; invoice['over_due_days'] &lt; 62">
												<!-- <t t-esc="'{:,}'.format(int(invoice['amount_due']))"/> -->
												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
											</t>
											<t t-else="">
												-
