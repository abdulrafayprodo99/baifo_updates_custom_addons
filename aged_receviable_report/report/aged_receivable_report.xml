											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if 30 &lt; invoice['over_due_days'] &lt; 46 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 30 &lt; invoice['over_due_days'] &lt; 46)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if 30 &lt; invoice['over_due_days'] &lt; 46 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 30 &lt; invoice['over_due_days'] &lt; 46)))"/>
												</t>
												<t t-else="">
													-
