											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if invoice['over_due_days'] &gt; 75 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if invoice['over_due_days'] &gt; 75)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if invoice['over_due_days'] &gt; 75 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if invoice['over_due_days'] &gt; 75)))"/>
