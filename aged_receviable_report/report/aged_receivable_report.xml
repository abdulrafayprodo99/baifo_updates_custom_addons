											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if 45 &lt; invoice['over_due_days'] &lt; 62 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 45 &lt; invoice['over_due_days'] &lt; 62)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if 45 &lt; invoice['over_due_days'] &lt; 62 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 45 &lt; invoice['over_due_days'] &lt; 62)))"/>
												</t>
												<t t-else="">
													-
												</t>
											</strong>
										</td>
