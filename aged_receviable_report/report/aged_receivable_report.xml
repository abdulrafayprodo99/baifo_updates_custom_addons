											</t>
											<t t-else="">
												<t t-esc="abs(invoice['over_due_days'])"/>
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="invoice['over_due_days'] &lt; 1">
												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="1 &lt; invoice['over_due_days'] &lt; 16">
