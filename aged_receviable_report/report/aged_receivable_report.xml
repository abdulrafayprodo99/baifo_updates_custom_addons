											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if 15 &lt; invoice['over_due_days'] &lt; 31 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 15 &lt; invoice['over_due_days'] &lt; 31)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if 15 &lt; invoice['over_due_days'] &lt; 31 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 15 &lt; invoice['over_due_days'] &lt; 31)))"/>
												</t>
