											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if 60 &lt; invoice['over_due_days'] &lt; 76 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 60 &lt; invoice['over_due_days'] &lt; 76)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if 61 &lt; invoice['over_due_days'] &lt; 75 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 61 &lt; invoice['over_due_days'] &lt; 75)))"/>
												</t>
												<t t-else="">
													-
