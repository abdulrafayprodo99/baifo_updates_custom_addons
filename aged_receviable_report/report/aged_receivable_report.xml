												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<t t-if="invoice['over_due_days'] &gt; 75">
												<!-- <t t-esc="'{:,}'.format(int(invoice['amount_due']))"/> -->
												<t t-if="invoice['currency_name'] !='PKR'">
													<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
												</t>
												<t t-else="">
													<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
												</t>
											</t>
											<t t-else="">
												-
											</t>
										</td>
										<td class="my-2 mx-2 text-end">
											<!-- <t t-esc="'{:,}'.format(int(invoice['amount_due']))"/> -->
											<t t-if="invoice['currency_name'] !='PKR'">
												<t t-esc="'{:,}'.format(int(invoice['currency_rate'] * invoice['amount_due']))"/>
											</t>
											<t t-else="">
												<t t-esc="'{:,}'.format(int(invoice['amount_due']))"/>
											</t>
										</td>
										<td class="my-2 mx-2"/>
										<!-- Example for Remarks -->
									</tr>
									<!-- Update Previous Narration -->
									<t t-set="previous_narration" t-value="invoice['narration']"/>
								</t>
								<!-- Subtotal Row for Each Narration -->
								<t t-if="previous_narration_for_total != invoice['narration']">
									<tr class="mx-2 text-end" style="margin-bottom: 20px;">
										<td class="my-2 text-end mx-2 " colspan="7" style="font-size:16px !important; font-family:sans-serif;">
											<strong>
												Total for
												<t t-esc="invoice['partner_name']"/>
												:
											</strong>
										</td>
										<td class="my-2 mx-2 text-end" style="font-size:16px !important; font-family:sans-serif;border-top: 2px solid black; border-bottom: 2px solid black; padding: 5px;">
											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if invoice['currency_name'] != 'PKR' and invoice['over_due_days'] &lt; 1 else invoice['amount_due'] for invoice in partner['invoices'] if invoice['over_due_days'] &lt; 1)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if invoice['currency_name'] != 'PKR' and invoice['over_due_days'] &lt; 1 else invoice['amount_due'] for invoice in partner['invoices'] if invoice['over_due_days'] &lt; 1)))"/>
												</t>
												<t t-else="">
													-
												</t>
											</strong>
										</td>
										<td class="my-2 mx-2 text-end" style="border-bottom: 2px solid black; padding: 5px; font-size:16px !important; font-family:sans-serif;border-top: 2px solid black;">
											<strong>
												<t t-if="int(sum((invoice['currency_rate'] * invoice['amount_due']) if 0 &lt; invoice['over_due_days'] &lt; 16 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 0 &lt; invoice['over_due_days'] &lt; 16)) &gt; 0">
													<t t-esc="'{:,}'.format(int(sum((invoice['currency_rate'] * invoice['amount_due']) if 0 &lt; invoice['over_due_days'] &lt; 16 and invoice['currency_name'] != 'PKR' else invoice['amount_due'] for invoice in partner['invoices'] if 0 &lt; invoice['over_due_days'] &lt; 16)))"/>
												</t>
												<t t-else="">
													-
												</t>
											</strong>
