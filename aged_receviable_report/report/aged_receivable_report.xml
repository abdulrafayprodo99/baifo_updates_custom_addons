									<t t-set="grand_total_75_plus" t-value="grand_total_75_plus + ((invoice['currency_rate']*invoice['amount_due']) if invoice['currency_name'] != 'PKR' else invoice['amount_due'] if invoice['over_due_days'] &gt; 75 else 0)"/>
									<t t-set="grand_total" t-value="grand_total + invoice['amount_due']"/>
									<!-- Row for Each Invoice -->
									<tr class="mx-2 text-end" style="margin-bottom: 20px;">
										<td class="my-2 mx-2 text-start" style="font-size:16px !important; font-family:sans-serif;">
											<t t-if="previous_narration != invoice['narration']">
												<strong>
													<t t-esc="invoice['narration']"/>
												</strong>
											</t>
										</td>
										<td style="width: 400px; font-size:16px !important; font-family:sans-serif;" class="my-2 mx-2 text-start ">
											<t t-if="previous_narration != invoice['narration']">
												<strong>
													<t t-esc="invoice['partner_name']"/>
												</strong>
											</t>
										</td>
										<td class="text-start my-2 mx-2" style="width: 200px;">
											<t t-esc="invoice['name']"/>
										</td>
										<td class="text-start my-2 mx-2" style="width: 150px;">
											<t t-esc="invoice['date']"/>
										</td>
										<td class="my-2 mx-2 text-start">
											<t t-esc="invoice['credit']"/>
										</td>
										<td class="my-2 mx-2 text-start">
