<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="aged_receivable_report">
		<t t-call="aged_receviable_report.external_layout_aged_analysis">
			<t t-call="web.html_container">
				<div class="page">
					<!-- <span style="font-weight: 950;font-size: 30px;"><b>osama</b></span> -->
					<!-- <span style="font-size: 30px;"><strong>osama</strong></span> -->
					<!-- <span class="fw-bold" style="font-weight:bold !important;font-size: 30px;font-family:sans-serif;">osama</span> -->
					<div class="center-content text-center">
						<h1 style="font-family: 'Times New Roman', serif;">
							Biafo Industries Limited
						</h1>
						<!--
						<h4 style="font-family: 'Times New Roman', serif;">
						Live
						</h4>
						-->
						<h2 style="font-family: 'Times New Roman', serif; color: black;">
							Aged Receivable Analysis As at
							<t t-esc="recorded_date"/>
						</h2>
						<h4 style="font-family: 'Times New Roman', serif;">
							(Rupees)
