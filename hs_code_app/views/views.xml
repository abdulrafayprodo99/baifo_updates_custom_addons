<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_view_product_template_form" model="ir.ui.view">
            <field name="name">product.template.inherit.form.view</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <field name="uom_po_id" position="before">
                    <field name="hs_code_id"/>
                    
                </field>
            </field>
    </record>


    <record id="hs_code_view_form" model="ir.ui.view">
        <field name="name">hs.code.view.form</field>
        <field name="model">hs.code</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
            
                    <field name="line_ids">
                        <tree editable='bottom'>
                            <field name="product_id"/>
                            <field name="tax_per"  widget="percentage"/>
                       </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="hs_code_model_action" model="ir.actions.act_window">
        <field name="name">HS Code</field>
        <field name="res_model">hs.code</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem name="HS Code" action="hs_code_model_action" id="hs_code_model_action_id" parent="account.account_account_menu"/>

</odoo>     