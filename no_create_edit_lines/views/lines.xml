        <field name="arch" type="xml">
            <!-- Target the product_template_id field -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <!-- Make the field readonly to prevent edits -->
                <!-- Prevent creation and opening of the field (disable create/edit) -->
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

        </field>
    </record>


    <record id="custom_stock_move_form_view" model="ir.ui.view">
        <field name="name">custom.stock.move.form.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Target the product_template_id field -->
            <xpath expr="//page[@name='operations']/field/tree/field[@name='product_id']" position="replace">
                <!-- Make the field readonly to prevent edits -->
                <!-- Prevent creation and opening of the field (disable create/edit) -->
                <!-- <attribute name="options">{'no_create': True,}</attribute> -->
                <field name="product_id" 
                required="1" 
                attrs="{'readonly': ['|', '&amp;', ('state', '!=', 'draft'), ('additional', '=', False), ('move_lines_count', '>', 0)]}" 
                options="{'no_create': True}"/>
         
            </xpath>



        </field>
    </record>


