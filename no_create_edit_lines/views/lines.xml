<odoo>
    <record id="custom_sale_order_form_view" model="ir.ui.view">
        <field name="name">custom.sale.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Target the product_template_id field -->
            <xpath expr="//field[@name='product_template_id']" position="attributes">
                <!-- Make the field readonly to prevent edits -->
                <!-- Prevent creation and opening of the field (disable create/edit) -->
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="custom_account_move_form_view" model="ir.ui.view">
        <field name="name">custom.account.move.form.view</field>
