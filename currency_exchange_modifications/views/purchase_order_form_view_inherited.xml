<?xml version="1.0" encoding='utf-8'?>
<odoo>
    <record id="purchase_order_form_view_modified_for_currency_rates" model='ir.ui.view'>
        <field name='name'>purchase.order.form.view.inherited.for.currency.rates</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="currency_name" invisible="1" />
                <field  name="currency_rate" attrs="{'invisible': [('currency_name','=','PKR')], 'readonly': [('state', '!=', 'draft')]}" />
            </xpath>
        </field>
    </record>
</odoo>