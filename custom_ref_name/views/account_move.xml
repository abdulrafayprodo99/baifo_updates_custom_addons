<odoo>
    <data>
        <!-- Inherit the account.view_move_form view -->
        <record id="view_move_form_custom" model="ir.ui.view">
            <field name="name">account.move.form.inherit.custom</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Locate the name field in the tree structure of line_ids -->
                <xpath expr="//form/sheet/notebook/page[@name='aml_tab']/field[@name='line_ids']/tree/field[@name='name']" position="after">
                    <!-- Replace the name field with name_2 -->
                    <field name="name_2"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
