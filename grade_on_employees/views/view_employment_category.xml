<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_category_form" model="ir.ui.view">
        <field name="name">employee.category.form</field>
        <field name="model">employee.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>                   
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_category_tree" model="ir.ui.view">
        <field name="name">employee.category.tree</field>
        <field name="model">employee.category</field>
        <field name="arch" type="xml">
            <tree>
               <field name="name" />
            </tree>
        </field>
    </record>

    <record id="employee_category_root_action" model="ir.actions.act_window">
        <field name="name">Employee Category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.category</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Your First Record
            </p>
        </field>
    </record>

    <menuitem id="employee_category_root_item" name="Employee Category" parent="hr.menu_config_employee" action="employee_category_root_action" sequence="12" />

</odoo>
