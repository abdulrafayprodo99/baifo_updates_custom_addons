<?xml version='1.0' encoding='utf-8'?>
<odoo>
     <record id="view_picking_form_inherit_new" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_done']" position="after">
                <!-- <field name="fields_separated" invisible="1" /> -->
                <field name="wr_no" attrs="{'invisible':[('picking_type_id','not in',[31])]}" />
                <!-- attrs="{'invisible':[('fields_separated','ilike','wr_no')]}" -->
            </xpath>
        </field>
    </record>
</odoo>