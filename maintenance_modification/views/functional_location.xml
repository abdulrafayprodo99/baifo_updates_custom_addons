<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="functional_location_form_view" model="ir.ui.view">
            <field name="name">functional.location.form</field>
            <field name="model">functional.location</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="sr_no" />
                        <!-- <field name="location_id" /> -->
                        <field name="location_name" />
                    </group>

                </form>
            </field>
        </record>

        <record id="view_functional_location_tree" model="ir.ui.view">
            <field name="name">functional.location.tree.view</field>
            <field name="model">functional.location</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sr_no" />
                    <!-- <field name="location_id" /> -->
                    <field name="location_name" />
                </tree>
            </field>
        </record>
        


        <record id="action_functional_location_view" model="ir.actions.act_window">
            <field name="name">Functional Location</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">functional.location</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>

        

    </data>
</odoo>