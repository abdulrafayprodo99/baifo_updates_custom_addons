<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="fault_category_form_view" model="ir.ui.view">
            <field name="name">fault.category.form</field>
            <field name="model">fault.category</field>
            <field name="arch" type="xml">
                <form string="Fault Category">
                    <group>
                        <field name="fault_category_id" />
                        <field name="fault_category_name" />
                    </group>

                </form>
            </field>
        </record>

        <record id="view_fault_category_tree" model="ir.ui.view">
            <field name="name">fault.category.form.view</field>
            <field name="model">fault.category</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="fault_category_id" />
                    <field name="fault_category_name" />
                </tree>
            </field>
        </record>
        


        <record id="action_fault_category_view" model="ir.actions.act_window">
            <field name="name">Fault Category</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">fault.category</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>

        

    </data>
</odoo>