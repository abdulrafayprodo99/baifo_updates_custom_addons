<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View maintenance.team form -->
    <record id="view_maintenance_team_tree_inherit" model="ir.ui.view">
        <field name="name">view.maintenance.team.tree.inherit</field>
        <field name="model">maintenance.team</field>
        <field name="inherit_id" ref="maintenance.maintenance_team_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='member_ids']" position="replace">
              <field name="emp_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

  </odoo>