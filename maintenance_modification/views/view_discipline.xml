<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="discipline_form_view" model="ir.ui.view">
            <field name="name">discipline.form</field>
            <field name="model">discipline</field>
            <field name="arch" type="xml">
                <form string="Discipline">
                    <group>
                         <field name="name"/>
                        <field name="name_des"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="view_discipline_tree" model="ir.ui.view">
            <field name="name">discipline.form.view</field>
            <field name="model">discipline</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" align="left"/>
                    <field name="name_des"/>
                </tree>
            </field>
        </record>

        <record id="action_discipline_view" model="ir.actions.act_window">
            <field name="name">PM Work Instructions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">discipline</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>
    </data>
</odoo>
