<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- GENERAL LEDGER -->
    <record id="preventive_maintenance_plan_wizard_form" model="ir.ui.view">
        <field name="name">Preventive Maintenance Plan (PMP)</field>
        <field name="model">preventive.maintenance.plan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group >
                    <field name="date_from" required="1" />
                    <field name="date_to" required="1"/>
                    <field name="stage_track"/>
                    <field name="stage_id"  options="{'no_create': True, 'no_create_edit': True}" attrs="{'invisible':[('stage_track','=',True)]}"/>
                    <field name="team" 
                    options="{'no_create': True, 'no_create_edit': True}"
                    help="Select a team to filter the requests by the team responsible for the equipment." />
                    
                </group>
                <footer>  
                    <button
                        name="button_export_pdf"
                        string="Export PDF"
                        type="object"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_preventive_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Preventive Maintenance Plan (PMP)</field>
        <field name="res_model">preventive.maintenance.plan.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="preventive_maintenance_plan_wizard_form" />
        <field name="target">new</field>
    </record>
    <menuitem id="menuitem_preventive_maintenance_plan_wizard" name="Preventive Maintenance Plan (PMP)" action="action_preventive_maintenance_plan" parent="maintenance.maintenance_reporting" sequence="3" />
</odoo>
