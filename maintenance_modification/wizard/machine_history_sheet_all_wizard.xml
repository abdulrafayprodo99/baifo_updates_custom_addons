<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- GENERAL LEDGER -->
    <record id="machine_history_sheet_wizard_form_all" model="ir.ui.view">
        <field name="name">Overall Maintenance Report</field>
        <field name="model">machine.history.sheet.wizard.all</field>
        <field name="arch" type="xml">
            <form>
                <group >
                    <!-- <field name="equipment_id" /> -->
                    <field name="start_date" />
                    <field name="end_date" />
                </group>
                <group >
                    <field name="stage_id"  options="{'no_create': True, 'no_create_edit': True}" />
                    <field name="team" 
                    options="{'no_create': True, 'no_create_edit': True}"
                    help="Select a team to filter the requests by the team responsible for the equipment." />
                    <!-- <field name="maintenance_type" /> -->
                </group>
                <footer>  
                    <button
                        name="button_export_pdf"
                        string="Export PDF"
                        type="object"
                    />
                    <button string="Cancel" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_machine_history_sheet_all" model="ir.actions.act_window">
        <field name="name">Overall Maintenance Report</field>
        <field name="res_model">machine.history.sheet.wizard.all</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="machine_history_sheet_wizard_form_all" />
        <field name="target">new</field>
    </record>
    <menuitem id="menuitem_overall_maintenance_report_wizard_all" name="Overall Maintenance Report" action="action_machine_history_sheet_all" parent="maintenance.maintenance_reporting" sequence="2" />
</odoo>
