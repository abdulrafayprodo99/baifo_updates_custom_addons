<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_machine_history_sheet_template"  >
       <t t-call="web.basic_layout">
        <style>
            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed; /* Ensures columns take up the available space evenly */
            }

            th, td {
                border: 1px solid black;
                padding: 10px;
                text-align: center;
                vertical-align: middle;
                white-space: normal; /* Allow text to wrap inside cells */
                word-wrap: break-word; /* Ensure long words wrap */
            }

            tr {
                min-height: 50px;
            }

            td {
                min-height: 50px;
            }

            /* Set minimum width for specific columns */
            th:nth-child(2), td:nth-child(2), /* Date */
            th:nth-child(5), td:nth-child(5), /* Start Time */
            th:nth-child(6), td:nth-child(6)  /* End Time */
            {
                min-width: 130px;
            }

            th:nth-child(8), td:nth-child(8) {
                min-width: 150px;
            }

            /* Style for "Performed By" badges */
            td span {
                display: inline-block;
                padding: 5px 10px;
                border-radius: 10px;
                background-color: #F9E0D9;
                min-width: 100px;
                text-align: center;
            }

            /* Description Column Specific Styling */
            th:nth-child(3), td:nth-child(3) {
                white-space: normal; /* Enable wrapping of text in the Description column */
                word-wrap: break-word;
                min-width: 200px; /* Prevent collapse of the Description column */
            }

            /* Adjust the page for A4 */
            .page {
                max-width: 100%;
                margin: 0 auto;
                font-family: 'Segoe UI', sans-serif;
                font-size: 15px;
            }

            @media print {
                .page {
                    width: 210mm; /* A4 width */
                    height: 297mm; /* A4 height */
                    padding: 20mm; /* Add padding to fit content on A4 */
                }

                table {
                    width: 100%;
                }

                .header, .footer {
                    display: none; /* Hide headers and footers when printing */
                }
            }
        </style>
        
        <t t-set="company" t-value="env.company"/>
        <!--<link href="https://fonts.googleapis.com/css2?family=Roboto" rel="stylesheet"/>-->
        
        <!-- Header Section -->
         <div class="header">
            <div class="row align-items-center mt-3">
              <!-- Logo -->
              <div class="col-3 text-start">
                  <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/> 
              </div>
              
              <!-- Header -->
              <div class="col-5 text-center">
                  <h3 style="margin: 0;">
                      <span t-field="company.name"/>
                  </h3>
                  <h4 style="font-size: 16px; font-weight: bold; margin-top: 5px; padding-bottom: 20px;">
                      Machines History Sheet
                  </h4>
              </div>
          </div>
        </div>
        <div class="page w-100" style="font-family:Segoe UI; font-size:15px">
            <table style="width:100%;" border="1">
                <thead>
                    <tr style="border:1px solid black;">
                        <th>Date</th>
                        <th>W.R No</th>
                        <th>Description</th>
                        <th>Start Time</th>
                        <th>End Time</th>
                        <th>Rectification Action</th>
                        <th>Performed By</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="list(requests)" t-as="req">
                        <td>
                          <t t-esc="req['schedule']"/>
                        </td>
                        <td>
                          
                        <t t-esc="req['wr_no']"/>
                        </td>
                        <td>
                          
                        <t t-esc="req['description']"/>
                        </td>
                        <td>
                          
                        <t t-esc="req['x_studio_job_start_time']"/>
                        </td>
                        <td>
                          
                        <t t-esc="req['x_studio_job_end_time']"/>
                        </td>
                        <td>
                          
                        <t t-esc="req['x_studio_rectification_action_1']"/>
                        </td>
                        <td style="box-sizing: border-box;overflow: hidden;">
                          <t t-foreach="list(req['job_assignment'])" t-as="assignee">
                            <span style="display:inline-block;padding:5px;border-radius:15px;background-color:#F9E0D9;margin:5px;" t-esc="assignee"/>
                          </t>
                        </td>
                        <td>
                          <t t-esc="req['job_performer_remarks']"/>
                        </td>
                    </tr> 
                </tbody>
            </table>
        </div>

        <!-- Main Content -->
        <div style="font-family: 'Roboto', sans-serif; margin: 20px; font-size: 16px; min-height: calc(100vh - 100px);">

        </div>
    </t>
    </template>

    <record id="btn_report_machine_history_sheet" model="ir.actions.report">
        <field name="name">Machine History Sheet</field>
        <field name="model">machine.history.sheet.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">maintenance_modification.report_machine_history_sheet_template</field>
        <field name="report_file">maintenance_modification.report_machine_history_sheet_template</field>
        <!-- <field name="paperformat_id" ref="report_qweb_paperformat" /> -->
    </record>

</odoo>
