<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_readonly_form" model="ir.ui.view">
        <field name="name">account.move.readonly.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="vendor_bills_readonly_check" invisible="1"/>
            </xpath>
            <xpath expr="//form" position="attributes">
                <attribute name="js_class">vendor_bills_form_disable_readonly</attribute>
            </xpath>
        </field>
    </record>
</odoo>
