<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_record_expence_tree" model="ir.ui.view">
        <field name="name">expense.module.tree</field>
        <field name="model">expense.module</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Name"/>
                <field name="journal"/>
                <field name="is_bank_payment"/>
            </tree>
        </field>
    </record>

        <!-- Rao Abdul Rehman -->

        
    <record id="view_expense_module_form" model="ir.ui.view">
        <field name="name">expense.module.form</field>
        <field name="model">expense.module</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="server_post_expense_action" states="draft" string="Post Expense" type="object"/>
                    <field name="lines_modified" invisible="1"/>
                    <button name="button_create_landed_costs" class="oe_highlight" string="Create Landed Costs" data-hotkey="l" type="object" attrs="{'invisible': [('landed_costs_visible', '!=', True)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>

                <!-- <header attrs="{'invisible': ['|',('is_bank_payment', '=', 'no'),('is_bank_payment', '=', False)]}">
                    <button name="action_prepared" attrs="{'invisible': [('approval_state', '!=', False)]}" string="prepared" type="object" class="oe_highlight"/>
                    <button name="action_checked" attrs="{'invisible': [('approval_state', '!=', 'prepared')]}" string="Checked" type="object" class="oe_highlight"/>
                    <button name="action_verify" attrs="{'invisible': [('approval_state', '!=', 'check')]}" string="Verifed" type="object" class="oe_highlight"/>
                    <button name="action_audit"  attrs="{'invisible': [('approval_state', '!=', 'verify')]}" string="Audited" type="object" class="oe_highlight"/>
                    <button name="action_approve"  attrs="{'invisible': [('approval_state', '!=', 'audit')]}" string="Approved" type="object" class="oe_highlight"/>
                    <button name="action_reject"  attrs="{'invisible': [('approval_state', 'not in', ['prepared','check','verify','audit','approve'])]}" string="Reject" type="object" class="oe_highlight"/>

                    <field name="approval_state" widget="statusbar" statusbar_visible="prepared,check,verify,audit,approve" />
                </header> -->
     
                <header attrs="{'invisible': [('is_bank_payment', '=', False)]}">
                    <button name="action_prepared_expense" attrs="{'invisible': [('approval_state_expense', '!=', False)]}" string="Prepared" type="object" class="oe_highlight"/>
                    <button name="action_verify_expense" attrs="{'invisible': [('approval_state_expense', '!=', 'prepared')]}" string="Verifed" type="object" class="oe_highlight"/>
                    <button name="action_approve_expense"  attrs="{'invisible': [('approval_state_expense', '!=', 'verify')]}" string="Approved" type="object" class="oe_highlight"/>
                    <button name="action_reject" attrs="{'invisible': [('approval_state_expense', 'not in', ['prepared','verify'])]}" string="Reject" type="object" class="oe_highlight"/>
                    <!-- <button name="action_update_journal_entry" type="object" string="Update Journal Entry" attrs="{'invisible': [('lines_modified', '=', False)]}" class="oe_highlight"/> -->
                    <button name="action_update_journal_entry" type="object" string="Update Journal Entry"  attrs="{'invisible': [('approval_state_expense', 'in', ['prepared', 'verify', 'approve'])]}" class="oe_highlight"/>
                    <field name="approval_state_expense" widget="statusbar" statusbar_visible="prepared,verify,approve" />
                </header>
                
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_patient_appointment" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="expense_count" string="Journal Entry" widget="statinfo"/>
                        </button>
                        <field name="landed_costs_ids" invisible="1"/>
                        <button string="Landed Costs" type="object"
                        name="action_view_landed_costs"
                        class="oe_stat_button" icon="fa-plus-square"
                        attrs="{'invisible': [('landed_costs_ids', '=', [])]}"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_type"/>
                            <field name="paid_to"/>
                            <field name="journal"/>
<!--                             <field name="account_id"/>
                            <field name="analytical_field" widget="analytic_distribution" />
                            <field name="total_expense" readonly="1"/> -->
                            <!-- <field name="expense_amount_in_words"/> -->
                            <field name="memo"/>
                            <field name="total_debit"/>                            
                            <field name="total_credit"/>
                            <field name="is_posted"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="temp_name" invisible="1"/>
                            <field name="seq_generate" invisible="1"/>

                        </group>
                        <group >
                            <field name="posting_date"/>
                            <field name="date"/>
                            <field name="cheque_date"/>
                            <field name="cheque_number"/>
                            <field name="landed_costs_visible"/>
                            <field name="is_bank_payment" invisible="1"/>

                        </group>
                    </group>
                    <notebook>
                        <page name="Expense Line" string="Expense line">
                             <field name="expense_line">
                        <tree editable="bottom">
                            <field name="general_item_type"/>
                            <field name="product_id"/>
                            <field name="is_landed_costs_line"/>
                            <field name="description"/>
                            <field name="account"/>
                            <field name="account_group_id"/>
                            <field name="trans_id"/>
                            <field name="paid_to"/>
                            <field name="partner"/>
                            <field name="analytical_field" widget="analytic_distribution" />
                            <!-- <field name="tags"/> -->
                            <field name="currency_id" invisible="1"/>
                            <field name="value"/>
                            <field name="expense_module_id" invisible="1"/>
                            <!-- <field name="analytic_distribution" widget="analytic_distribution" readonly="1"/> -->
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="general_item_type"/>
                                    <field name="account"/>
                                    <field name="description"/>
                                    <field name="partner"/>
                                    <field name="analytical_field" widget="analytic_distribution" />
                                    

                                    <!-- <field name="analytic_distribution" widget="analytic_distribution" readonly="1"/> -->

                                </group>
                                <group>
                                    <!-- <field name="tags"/> -->
                                    <field name="currency_id" invisible="1"/>
                                    <field name="value"/>
                                </group>
                            </group>
                        </form>
                    </field>
                        </page>
                        <page name="Approval Logs" string="Approval Logs">
                            <group name="Bank Voucher" string="Bank Voucher" attrs="{'invisible': [('is_bank_payment', '=', 'no')]}">
                                <group >
                                    <field name="prepared_by" readonly="1"/>
                                    <!-- <field name="checked_by" readonly="1"/> -->
                                    <field name="verify_by" readonly="1" />
                                    <!-- <field name="audit_by" readonly="1"/> -->
                                    <field name="Approve_by" readonly="1"/>
                                </group>
                                <group>
                                    <field name="prepared_timestamp"/>
                                    <!-- <field name="checked_timestamp"/> -->
                                    <field name="verify_timestamp"/>
                                    <!-- <field name="audit_timestamp"/> -->
                                    <field name="approve_timestamp"/>
                                </group>
                            </group>
                            
                            <group name="Expense Voucher" string="Expense Voucher" attrs="{'invisible': [('is_bank_payment', '=','yes')]}">
                                <group>
                                    <field name="prepare_expense" readonly="1" />
                                    <field name="verified_expense" readonly="1" />
                                    <field name="approve_expense"  readonly="1" />
                                </group>
                                <group>
                                    <field name="prepare_expense_timestamp" readonly="1" />
                                    <field name="verified_expense_timestamp" readonly="1" />
                                    <field name="approve_expense_timestamp" readonly="1" />
                                </group>
                            </group>
                            <group name="Rejection Note" string="Rejection Note">
                                <field name="reject_note"/>
                            </group>
                        </page>
                    </notebook>
                   
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
            </div>
            </form>
        </field>
    </record>

    <record id="record_expanse_action" model="ir.actions.act_window">
        <field name="name">Expense Module</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.module</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                 Create Your First Record Expense
            </p>
        </field>
    </record>

    <record id="view_move_form_asset_inherit_account" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.journal</field>

        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="before">
                <field name="is_miscellaneous_journal" />
            </field>

        </field>
    </record>
    <record id="jv_inherited" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>

        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
                <xpath expr="//form[1]/sheet[1]/group[1]/group[1]/field[@name='ref'][2]" position="after">
                    <field name="cheque_number"/>
                </xpath>

        </field>
    </record>



    <menuitem id="record_expense_root" name="Record Expense" parent="" sequence="10" />
    <menuitem id="record_expense" name="Expense Module" parent="record_expense_root" action="record_expanse_action" sequence="10"/>
</odoo>