<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="purchase_request_line_tree_inherited_for_po_ids" model="ir.ui.view">
        <field name="name">purchase.request.line.tree.inherit</field>
        <field name="model">purchase.request.line</field>
        <field name="inherit_id" ref="purchase_request.purchase_request_line_tree"/>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='estimated_cost']" position="after">
            <field name="po_ids" widget="many2many_tags" string="PO/RFQ" />
        </xpath>
        </field>
    </record>
</odoo>