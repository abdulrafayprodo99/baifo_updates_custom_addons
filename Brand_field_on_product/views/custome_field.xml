<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add custom fields to the product form view -->
    <record id="new_field_id" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="brand" />
                <field name="brand_id" />
            </xpath>
        </field>
    </record>

    <!-- Tree View for Product Brand -->
    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                
            </tree>
        </field>
    </record>

    <!-- Action for Product Brand -->
    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_product_brand_tree"/>
    </record>

    <!-- Menu Item for Product Brands -->
    <menuitem id="menu_product_brand" 
              name="Product Brands"
              parent="stock.menu_stock_config_settings" 
              action="action_product_brand"
              sequence="10"/>
</odoo>
