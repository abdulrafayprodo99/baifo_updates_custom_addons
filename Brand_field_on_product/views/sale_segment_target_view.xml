<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for listing all records -->
    <record id="sales_segment_target_tree_view" model="ir.ui.view">
        <field name="name">sales.segment.target.tree</field>
        <field name="model">sales.segment.target</field>
        <field name="arch" type="xml">
            <tree string="Sales Segment Target">
                <field name="name"/>
                <field name="tag"/>
                <field name="validate_from"/>
                <field name="validate_to"/>
                <field name="target"/>
            </tree>
        </field>
    </record>

    <!-- Form view for creating/editing records -->
    <record id="sales_segment_target_form_view" model="ir.ui.view">
        <field name="name">sales.segment.target.form</field>
        <field name="model">sales.segment.target</field>
        <field name="arch" type="xml">
            <form string="Sales Segment Target">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tag"/>
                            <field name="target"/>
                        </group>
                        <group>
                            <field name="customer_field"/>
                            <field name="validate_from"/>
                            <field name="validate_to"/>
                        </group>
                    </group>
                    <!-- tesing here -->
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action to load both views: tree first, then form -->
    <record id="action_sales_segment_target" model="ir.actions.act_window">
        <field name="name">Sales Projection</field>
        <field name="res_model">sales.segment.target</field>
        <field name="view_mode">tree,form</field>
        <!-- Remove view_id to allow both views to load dynamically -->
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('sales_segment_target_tree_view')}), (0, 0, {'view_mode': 'form', 'view_id': ref('sales_segment_target_form_view')})]"/>
    </record>

    <!-- Menu item to access the list of sales segment targets -->
    <menuitem id="menu_target" name="Sales Projection"
        parent="sale.menu_sale_config"
        action="action_sales_segment_target"
        sequence="99"/>

</odoo>
