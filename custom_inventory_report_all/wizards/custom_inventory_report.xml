<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="custom_inventory_report_all_form" model="ir.ui.view">
            <field name="name">custom.inventory.report.form</field>
            <field name="model">custom.inventory.report.all</field>
            <field name="arch" type="xml">
                <form string="Inventory Report (All)">
                    <group>
                        <group colspan="4" >
                            <!-- <group string="Report">
                                <field name="report_type" widget="radio"/>
                            </group> -->
                            <group string="Date">
                                <field name="date_filter" widget="radio"/>
                                <field name="from_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                                <field name="to_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                            </group>
                            <br/>
                            <br/>
                            <group string="Product">
                                <field name="product_filter" widget="radio"/>
                                <field name="product_ids" widget="many2many_tags" attrs="{'invisible':[('product_filter','!=','single')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="from_product" attrs="{'invisible':[('product_filter','!=','range')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                                <field name="to_product" attrs="{'invisible':[('product_filter','!=','range')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Location">
                                <field name="location_filter" widget="radio"/>
                                <field name="location" widget="many2many_tags" attrs="{'invisible':[('location_filter','!=','single')]}" options="{'no_create': True, 'no_create_edit':True}"/>
                            </group>
                            <br/>
                            <br/>
                            <group string="Category">
                                <field name="category_filter" widget="radio" />
                                <field name="product_category_ids" widget="many2many_tags" attrs="{'invisible':[('category_filter','!=','single')]}" options="{'no_create': True, 'no_create_edit':True}" />
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Configure Report">
                                <field name="with_amount" widget="radio" />
                                <field name="with_qty" widget="radio" />
                            </group>
                        </group>
                      </group>
                    <footer>
                        <!-- <button name="download_report" string="Excel Report" type="object"
                                class="oe_highlight"/> -->
                        <button name="download_report_pdf" string="PDF Report" type="object"
                                class="oe_highlight"/>
                        <button name="download_report_excel" string="Excel Report" type="object"
                                class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>

                </form>
            </field>
        </record>

        <record id="custom_inventory_report_all_action" model="ir.actions.act_window">
            <field name="name">Inventory Status Report</field>
            <field name="res_model">custom.inventory.report.all</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="custom_inventory_report_all_menu_item" action="custom_inventory_report_all_action"
                  parent="stock.menu_warehouse_report"
                  sequence="20" />


    </data>
</odoo>