        <record id="purchase_request_line_inherit_form_close_pr" model="ir.ui.view">
            <field name="name">purchase.line.request.form.inherit</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="prodo_x_biafo_ext.purchase_request_inherited_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet[1]" position="inside">
                    <field name="check_user_exists_in_group" invisible="1"/>
                </xpath>
                <xpath expr="//header[1]" position="inside">
                    <button name="reset_to_approve" string="Reset" type="object" class="btn-primary" attrs="{'invisible': ['|',('approval_state', '!=', 'close_pr'),('check_user_exists_in_group','!=',True)]}" />                    
                </xpath>
                <xpath expr="//field[@name='line_ids']" position="attributes">
                    <attribute name="attrs">{'readonly': [('approval_state', '=', 'close_pr')]}</attribute>
                </xpath>
                <xpath expr="//button[@name='open_cancel_wizard']" position="replace">
                <button name="open_cancel_wizard" attrs="{'invisible': [('approval_state', 'in', ['cancel','close_pr'])]}" string="Cancel"  type="object" class="oe_highlight"/>
            </xpath>
            </field>
        </record>
    </data>
</odoo>
