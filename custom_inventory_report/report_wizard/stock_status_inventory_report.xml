<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="stock_status_inventory_report_wizard_form" model="ir.ui.view">
            <field name="name">stock.status.inventory.report.wizard.form</field>
            <field name="model">stock.status.inventory.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Stock Status Inventory Report">
                    <group>
                        <group colspan="4" >
                            <group string="Date">
                                <field name="date_filter" widget="radio"/>
                                <field name="from_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                                <field name="to_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Product">
                                <field name="product_filter" widget="radio"/>
                                <field name="product_ids" widget="many2many_tags" attrs="{'invisible':[('product_filter','!=','single')]}"/>
                                <field name="from_product" attrs="{'invisible':[('product_filter','!=','range')]}"/>
                                <field name="to_product" attrs="{'invisible':[('product_filter','!=','range')]}"/>
                            </group>
                            <br/>
                            <br/>
                            <group string="Location">
                                <field name="location_filter" widget="radio"/>
                                <field name="location" widget="many2many_tags" attrs="{'invisible':[('location_filter','!=','single')]}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Category">
                                <field name="category_filter" widget="radio" />
                                <field name="product_category_ids" widget="many2many_tags" attrs="{'invisible':[('category_filter','!=','single')]}" />
                            </group>
                            <group string="Configure Report">
                                <field name="render_type" widget="radio" />
                            </group>
                        </group>
                      </group>
                    <footer>
                        <button name="action_print_excel_report" string="Excel Report" type="object"
                                class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="stock_status_inventory_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Stock Status Inventory Report</field>
            <field name="res_model">stock.status.inventory.report.wizard</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="stock_status_inventory_report_menu_item" action="stock_status_inventory_report_wizard_action"
                  parent="stock.menu_warehouse_report"
                  sequence="23" />

    </data>
</odoo>