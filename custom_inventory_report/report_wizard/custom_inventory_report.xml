<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="custom_inventory_report_form" model="ir.ui.view">
            <field name="name">custom.inventory.report.form</field>
            <field name="model">custom.inventory.report</field>
            <field name="arch" type="xml">
                <form string="Inventory Report">
                    <group>
                        <group colspan="4" >
                            <group string="Report">
                                <field name="report_type" widget="radio"/>
                            </group>
                            <br/>
                            <br/>
                            <group string="Date">
                                <field name="date_filter" widget="radio"/>
                                <field name="from_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                                <field name="to_date" attrs="{'invisible':[('date_filter','!=','range')]}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Product">
                                <field name="product_filter" widget="radio"/>
                                <field name="product_ids" widget="many2many_tags" attrs="{'invisible':[('product_filter','!=','single')]}"/>
                                <field name="from_product" attrs="{'invisible':[('product_filter','!=','range')]}"/>
                                <field name="to_product" attrs="{'invisible':[('product_filter','!=','range')]}"/>
                            </group>
                            <br/>
                            <br/>
                            <group string="Location">
                                <field name="location_filter" widget="radio"/>
                                <field name="location" widget="many2many_tags" attrs="{'invisible':[('location_filter','!=','single')]}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <group string="Category">
                                <field name="category_filter" widget="radio" />
                                <field name="product_category_ids" widget="many2many_tags" attrs="{'invisible':[('category_filter','!=','single')]}" />
                            </group>
                            <group string="Configure Report">
                                <field name="with_amount" widget="radio" />
                                <field name="with_qty" widget="radio" />
                            </group>
                        </group>
                      </group>
                    <footer>
                        <button name="downlaod_report_pdf" string="PDF Report" type="object"
                        class="oe_highlight"/>
                        <button name="action_print_excel_report" string="Excel Report" type="object"
                                class="oe_highlight"/>
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>

                </form>
            </field>
        </record>

        <record id="custom_inventory_report_action" model="ir.actions.act_window">
            <field name="name">Inventory List Report</field>
            <field name="res_model">custom.inventory.report</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="custom_inventory_report_menu_item" action="custom_inventory_report_action"
                  parent="stock.menu_warehouse_report"
                  sequence="20" />

        <record id="view_excel" model="ir.ui.view">
            <field name="name">view.stock.excel </field>
            <field name="model">customer.invoices.report.excel</field>
            <field name="arch" type="xml">
                <form string="Generate Excel File">
                    <group>
                            <field name="file_name" invisible="1" />
                            <field name="excel_file" readonly="1" filename="file_name" />
                    </group>
                    <footer>
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>