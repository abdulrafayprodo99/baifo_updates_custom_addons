<odoo>
    <!-- Wizard View -->
    <record id="view_allowance_details_report_wizard" model="ir.ui.view">
        <field name="name">allowance.details.wizard.form</field>
        <field name="model">allowance.details.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="month" />
                    <field name="year"/>
                    <field name="allowance_type"/>
                    <field name="report_type" widget="radio"/>
                </group>
                <footer>
                    <button name="generate_report" string="Generate Report" type="object" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_allowance_details_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Allowance Details Report</field>
        <field name="res_model">allowance.details.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item for Wizard -->
    <menuitem id="menu_allowance_details_report_wizard"
              name="Allowance Details Report"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_allowance_details_report_wizard"
              sequence="10"/>


</odoo>
