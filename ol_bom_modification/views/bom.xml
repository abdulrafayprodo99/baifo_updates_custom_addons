    <record id="view_mrp_bom_tree_inherit" model="ir.ui.view">
        <field name="name">mrp.bom.tree.inherit</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="attributes">
                <attribute name="widget"/>
            </xpath>
            
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="batch_no" optional="show"/>
                <field name="bom_version_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='code']" position="after">
                <field name="effective_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <!-- <field name="state" optional="show"/> -->
            </xpath>
            <xpath expr="//field[@name='type']" position="replace">
                <!-- <attribute name="attrs">{}</attribute> -->
                <field name="state"/>
                <!-- <attribute name="invisible">1</attribute> -->
            </xpath>
        </field>
    </record>
