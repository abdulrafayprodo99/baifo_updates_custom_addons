<odoo>

    <data>
    <record id="view_bom_fields" model="ir.ui.view">
        <field name="name">bom.fields</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes">
                <attribute name="js_class">view_form_disable</attribute>
            </xpath>
            <xpath expr="/form/sheet[1]" position="before">
                <header>
                    <button name="action_approve" type="object" string="Approve" attrs="{'invisible': [('state', '=', 'approved')]}"/>
                    <button name="action_disapprove" type="object" string="Disapprove" attrs="{'invisible': [('state', '=', 'not_approved')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="not_approved,approved"/>
                </header>
            </xpath>


            <xpath expr="//field[@name='type']" position="after">
                <field name="standard_rate"/>
                <field name="state_display"/>
                <field name="bom_version_id"/>
                <field name="total_cost" invisible="1" />
            </xpath>
        <xpath expr="//field[@name='product_uom_id']" position="before">
            <label for="product_uom_id" string="Unit of Measure"/>
        </xpath>
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="sequence"/>
                <field name="batch_no"/>  
                <field name="effective_date" />
                <field name="end_date" />
                <field name="readonly_check" invisible="1" />
            </xpath>
        </field>
    </record>

