<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_iso_tree" model="ir.ui.view">
        <field name="name">iso.tree</field>
        <field name="model">iso</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Name"/>
                <field name="iso_number" string="ISO Number"/>
                
            </tree>
        </field>
    </record>

    <record id="view_iso_form" model="ir.ui.view">
        <field name="name">iso.form</field>
        <field name="model">iso</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="iso_number"/>
                            
                            
                            
                        </group>
                        
                    </group>
                        
                </sheet>
            </form>
        </field>
    </record>

    <record id="iso_action" model="ir.actions.act_window">
            <field name="name">ISO</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">iso</field>
            <field name="view_mode">tree,form</field>
        </record>

    <menuitem id="iso_root" name="ISO" parent="" sequence="10" />
    <menuitem id="iso" name="ISO" parent="iso_root" action="iso_action" sequence="11"/>
</odoo>