<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_bank_letter" model="report.paperformat">
        <field name="name">Bank Letter</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="bank_letter_pdf_report_action" model="ir.actions.report">
        <field name="name">Bank Letter PDF</field>
        <field name="print_report_name">f'Bank Letter Report'</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bank_letter.report_bank_letter_pdf</field>
        <field name="report_file">bank_letter.report_bank_letter_pdf</field>
        <field name="paperformat_id" ref="bank_letter.paperformat_bank_letter" />
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="bank_letter_excel_report_action" model="ir.actions.report">
        <field name="name">Bank Letter Excel</field>
        <field name="print_report_name">f'Bank Letter Report'</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">bank_letter.report_bank_letter_excel</field>
        <field name="report_file">bank_letter.report_bank_letter_excel</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>