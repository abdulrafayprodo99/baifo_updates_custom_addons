<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_bank_letter_pdf">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    * {
                        font-family: Arial, sans-serif;
                        font-size: 18px;
                    }                
                    td, tr, tbody, th, thead {
                        border: none;
                    }
                    th {
                        border: 2px solid black; 
                    }                    
                </style>            
                <div class="page">
                    <table style="width: 100%;">
                        <tr>
                            <td style="width: 50%; vertical-align: top;">
                                The Manager,
                            </td>
                            <td style="width: 50%; text-align: right; vertical-align: top;">
                                <t t-esc="date"/>
                            </td>
                        </tr>
                    </table>
                    <br/>
                    <br/>
                    <p>
                        <t t-esc="bank_name"/><br/>
                        <t t-foreach="address" t-as="line">
                            <t t-esc="line" /><br/>
                        </t>
                    </p>                    
                    <br/>
                    <p>PAYMENT INSTRUCTION</p>
                    <br/>
                    <p>Dear Sir,<br /><br />You are requested to debit our Account No. <t t-esc="account_number" /> titled Biafo Industries Limited and transfer
                       the salary amounting Rs. <t t-esc="total_amount"/>/- (<t t-esc="total_amount_iw"/>) to the credit of following individual's Account
                       Numbers of Biafo employees being maintained at your branch: </p>

                    <t t-set="count" t-value="1" />
                    <table class="table table-sm" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>S.No.</th>
                                <th>Emp Code</th>
                                <th style="text-align: left;">Name</th>
                                <th style="text-align: left;">Account Number</th>
                                <th>Amount (Rs.)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="payslips" t-as="payslip">
                                <tr>
                                    <td style="text-align: center;">
                                        <t t-esc="count" />
                                    </td>
                                    <td style="text-align: center;">
                                        <t t-esc="payslip['emp_code']" />
                                    </td>
                                    <td>
                                        <t t-esc="payslip['name']" />
                                    </td>
                                    <td>
                                        <t t-esc="payslip['account']" />
                                    </td>
                                    <td style="text-align: right;">
                                        <t t-esc="payslip['amount']" />
                                    </td>
                                </tr>
                                <t t-set="count" t-value="count + 1" />
                            </t>
                            <tr>
                                <td colspan="2">
                                </td>
                                <td colspan="2" style="text-align: center;">
                                    <strong>
                                        TOTAL Rs.
                                    </strong>
                                </td>
                                <td style="text-align: right; border-top: 2px solid black; border-bottom: 2px solid black;">
                                    <strong>
                                        <t t-esc="total_amount" />
                                    </strong>
                                </td>
                            </tr>                            
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>