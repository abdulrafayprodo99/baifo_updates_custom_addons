<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_warehouse_orderpoint_tree_editable_inherited_custom" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.inherited.custom</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="purchase_stock.view_warehouse_orderpoint_tree_editable_inherited_mrp"/>
        <field name="arch" type="xml">
            <!-- Add fields after supplier_id -->
            <xpath expr="//field[@name='qty_forecast']" position="replace">
                <field name="forecast_quantity" />
                <field name="onhand" />
                <field name="reorder_level" />
                <field name="final_safety_stock_level" />
                <field name="max_lead_time" />
                <field name="avg_lead_time" />
                <field name="min_lead_time" />
                <field name="max_consumption" />
                <field name="avg_consumption" />
                <field name="current_stock" />
            </xpath>

            <xpath expr="//field[@name='qty_on_hand']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_replenish']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>

    </record>
</odoo>
