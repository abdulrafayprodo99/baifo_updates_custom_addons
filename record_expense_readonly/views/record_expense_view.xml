<?xml version="1.0" encoding='utf-8'?>
<odoo>

    <record id="expense_form_readonly_form" model='ir.ui.view'>
        <field name='name'>expense.form.readonly</field>
        <field name="model">expense.module</field>
        <field name="inherit_id" ref="Record_Expense.view_expense_module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_posted']" position='after'>
                <field name="readonly_check"/>
                
            </xpath>

            <xpath expr="//form" position="attributes">
                <attribute name="js_class">view_form_disable_readonly</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_reset_to_draft" type="object" string="Reset to Draft" states="posted" class="btn-secondary"/>
            </xpath>

            
        </field>
    </record>

</odoo>