<odoo>
    <record id="new_field_id" model="ir.ui.view">
        <field name="name">product.template.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='brand_id']" position="after">
                <field name="default_purchase_rate"/>
            </xpath>
        </field>
    </record>


    <!-- Inherit the BOM form view -->
    <record id="view_bom_form_custom" model="ir.ui.view">
        <field name="name">mrp.bom.form.custom</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <!-- Inherit and modify the Components page -->
            <xpath expr="//page[@name='components']/field[@name='bom_line_ids']/tree//field[@name='product_qty']" position="before">
                <!-- Add the custom field default_purchase_rate before product_qty -->
                <field name="default_purchase_rate"/>
            </xpath>
            
            <!-- Add the total_cost field after the product_qty -->
            <xpath expr="//page[@name='components']/field[@name='bom_line_ids']/tree//field[@name='product_qty']" position="after">
                <field name="total_cost" />
            </xpath>
        </field>
    </record>
</odoo>