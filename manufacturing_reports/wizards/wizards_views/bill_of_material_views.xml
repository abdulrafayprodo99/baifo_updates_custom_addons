<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- View for the Bill of Material Report Wizard -->
        <record id="view_bill_of_material_wizard" model="ir.ui.view">
            <field name="name">bill.of.material.wizard.form</field>
            <field name="model">bill.of.material.wizard</field>
            <field name="arch" type="xml">
                <form string="Bill of Material Report Wizard">
                    <group>
                    <group string="Date">
                        <field name="effective_date"/>
                        <!-- <field name="to_date"/> -->
                    </group>
                    <group string="Product">
                        <field name="product_domain" invisible="1" />
                        <field name="batches" />
                        <field name="product_filter" widget="radio"/>
                        <field name="product_ids" widget="many2many_tags" attrs="{'invisible':[('product_filter','!=','single')]}" domain="[('id','in',product_domain)]" />
                        <field name="from_product" attrs="{'invisible':[('product_filter','!=','range')]}" domain="[('id','in',product_domain)]"/>
                        <field name="to_product"   attrs="{'invisible':[('product_filter','!=','range')]}" domain="[('id','in',product_domain)]"  />
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf_report" type="object" string="Print PDF Report" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>


