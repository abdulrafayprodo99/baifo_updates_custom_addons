<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_material_requirement_wizard" model="ir.ui.view">
            <field name="name">material.requirement.wizard.form</field>
            <field name="model">material.requirement.wizard</field>
            <field name="arch" type="xml">
                <form string="Material Requirement Wizard">
                    <group>
                        <!-- <field name="from_date"/>
                        <field name="to_date"/> -->
                        <field name="material_id" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button string="Generate Report" type="object" name="generate_report" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
