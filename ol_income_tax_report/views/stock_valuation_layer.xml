<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_stock_valuation_layer_tree" model="ir.ui.view">
        <field name="name">view.stock.valuation.layer.tree</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="after">
                <field name="job_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_valuation_layer_search" model="ir.ui.view">
        <field name="name">view.stock.valuation.layer.search</field>
        <field name="model">stock.valuation.layer</field>
        <field name="inherit_id" ref="stock_account.view_inventory_valuation_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reference']" position="after">
                <field name="job_id"/>
            </xpath>
        </field>
    </record>
</odoo>
